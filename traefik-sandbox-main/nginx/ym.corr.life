server {
    listen       80;
    listen       443 ssl;
 
    server_name  ym.corr.life;
 
    location ~ /.well-known {
        root /usr/share/nginx/html;
        allow all;
    }
 
    if ($scheme = 'http') {
        return 301 https://$host$request_uri;
    }
 
    ssl_certificate     /etc/nginx/ssl/ym.corr.life.crt;
    ssl_certificate_key /etc/nginx/ssl/ym.corr.life.key;
 
    root  /usr/share/nginx/html;
 
    error_log /var/log/nginx/error.log;
 
    index index.html;
 
    location / {
        try_files $uri $uri/ index.html;
    }
 
    location ~* ^.+\.(jpg|jpeg|gif|png|css|zip|tgz|gz|rar|bz2|doc|docx|xls|xlsx|exe|pdf|ppt|tar|wav|bmp|rtf|js)$ {
            expires modified +1w;
    }
}
